<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification | Team Hex</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f3f4f6;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f3f4f6; padding: 32px 12px"
    >
      <tr>
        <td align="center">
          <!-- Main Card -->
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 480px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td align="center" style="padding: 32px 24px 16px">
                <h2
                  style="
                    margin: 0;
                    color: #111827;
                    font-size: 24px;
                    font-weight: bold;
                  "
                >
                  Verify Your Email
                </h2>

                <p
                  style="
                    margin: 12px 0 0;
                    color: #6b7280;
                    font-size: 14px;
                    line-height: 1.6;
                  "
                >
                  Thank you for using our services.<br />
                  Use the verification code below to continue.
                </p>
              </td>
            </tr>

            <!-- OTP Section -->
            <tr>
              <td align="center" style="padding: 16px 24px 24px">
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #eff6ff;
                    border: 1px solid #bfdbfe;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 20px 24px">
                      <p
                        style="
                          margin: 0 0 10px;
                          color: #4b5563;
                          font-size: 13px;
                          font-weight: bold;
                        "
                      >
                        YOUR VERIFICATION CODE
                      </p>

                      <p
                        style="
                          margin: 0;
                          color: #1d4ed8;
                          font-size: 34px;
                          font-weight: bold;
                          letter-spacing: 8px;
                          white-space: nowrap;
                        "
                      >
                        <%= otp %>
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 20px 0 0;
                    color: #6b7280;
                    font-size: 13px;
                    line-height: 1.6;
                  "
                >
                  This code expires in
                  <strong style="color: #111827">5 minutes</strong>.
                </p>
              </td>
            </tr>

            <!-- Security Notice -->
            <tr>
              <td style="padding: 0 24px 28px">
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="background-color: #fff7ed; border-radius: 8px"
                >
                  <tr>
                    <td
                      style="
                        padding: 14px;
                        color: #9a3412;
                        font-size: 12px;
                        line-height: 1.6;
                      "
                    >
                      <strong>Security Notice</strong><br />
                      Never share this code with anyone. If you did not request
                      this verification, you can safely ignore this email.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 24px;
                  border-top: 1px solid #e5e7eb;
                  color: #6b7280;
                  font-size: 12px;
                  line-height: 1.8;
                "
              >
                <p
                  style="
                    margin: 0 0 4px;
                    color: #111827;
                    font-size: 16px;
                    font-weight: bold;
                  "
                >
                  Team Hex
                </p>

                <p style="margin: 0 0 8px">
                  Secure verification for your account.
                </p>

                <p style="margin: 0; color: #9ca3af; font-size: 11px">
                  &copy; 2026 Team Hex. All rights reserved.
                </p>

                <p style="margin: 8px 0 0; color: #9ca3af; font-size: 11px">
                  This is an automated message.<br />
                  Please do not reply to this email.
                </p>
              </td>
            </tr>
          </table>
          <!-- End Main Card -->
        </td>
      </tr>
    </table>
  </body>
</html>
